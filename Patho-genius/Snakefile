"""
Pathogenius – Dual-Engine Snakemake Pipeline
=============================================
Supports two classification engines selected via config:
  engine: "cpu"  →  CLARK-l via Docker (runs locally)
  engine: "gpu"  →  CU-CLARK-L on Jetson Nano via Tailscale SSH (GPU-accelerated)

Workflow:
  1. clark_lite_classify    – classify FASTQ reads (Docker or SSH)
  2. clark_abundance_report – estimate abundance (Docker or local Python)
  3. clark_to_json          – local JSON conversion for the Electron UI
"""
#TEST

import os
import csv
import sys
import json
from datetime import datetime

# CLARK output CSVs can contain fields exceeding Python's default
# csv.field_size_limit (131 072 bytes). Raise the limit so csv.reader
# never chokes on them. On Windows, passing sys.maxsize can overflow
# C long, so progressively reduce until accepted.
def _set_max_csv_field_size_limit():
    max_int = sys.maxsize
    while True:
        try:
            csv.field_size_limit(max_int)
            return
        except OverflowError:
            max_int = max_int // 10


_set_max_csv_field_size_limit()

configfile: "config.yaml"

SAMPLE  = config.get("sample", "SRR7497167_1-001")
ENGINE  = config.get("engine", "cpu")   # "cpu" or "gpu"
BASEDIR = workflow.basedir

# ─── Local paths (both engines) ────────────────────────────────────────────────
DB_HOST      = os.path.abspath(os.path.join(BASEDIR, config["paths"]["db_host_windows"])).replace("\\", "/")
DATA_HOST    = os.path.abspath(os.path.join(BASEDIR, config["paths"]["data_host_windows"])).replace("\\", "/")
RESULTS_HOST = os.path.abspath(os.path.join(BASEDIR, "results", "clark")).replace("\\", "/")

# ─── CPU engine (Docker) ──────────────────────────────────────────────────────
IMAGE      = config["clark"].get("image", "")
CLARK_DIR  = "/usr/local/opt/clark"   # CLARK install path inside the Docker container

# ─── GPU engine (Jetson Nano via SSH) ──────────────────────────────────────────
JETSON_HOST  = config.get("jetson_nano", {}).get("host", "")
JETSON_USER  = config.get("jetson_nano", {}).get("user", "")
REMOTE_DB    = config.get("jetson_nano", {}).get("remote_db", "")
REMOTE_WS    = config.get("jetson_nano", {}).get("remote_workspace", "")
CUCLARK_DIR  = config.get("jetson_nano", {}).get("cuclark_dir", "")
SSH_BATCH_MODE = bool(config.get("jetson_nano", {}).get("ssh_batch_mode", True))
SSH_BATCH_OPT  = "yes" if SSH_BATCH_MODE else "no"
SSH_TARGET   = f"{JETSON_USER}@{JETSON_HOST}" if JETSON_USER and JETSON_HOST else ""

print(f"[Pathogenius] Engine: {ENGINE.upper()} | Sample: {SAMPLE}")

# ─── DAG target ────────────────────────────────────────────────────────────────
rule all:
    input:
        f"results/clark/{SAMPLE}.json"


# ═══════════════════════════════════════════════════════════════════════════════
# RULE 1 – Classification
# ═══════════════════════════════════════════════════════════════════════════════
rule clark_lite_classify:
    """
    Classify FASTQ reads using CLARK-l (CPU / Docker) or CU-CLARK-L (GPU / Jetson Nano).
    The engine is selected via the 'engine' config parameter.

    Output CSV columns:
      Object_ID, Length, 1st_assignment (taxid), hit_count_1,
      2nd_assignment, hit_count_2, confidence_score
    """
    input:
        fastq=os.path.join(DATA_HOST, f"{SAMPLE}.fastq")
    output:
        clark_csv=f"results/clark/{SAMPLE}.clark.csv"
    params:
        # Shared
        sample     = SAMPLE,
        threads    = config["clark"]["threads"],
        kmer       = config["clark"].get("kmer_length", 27),
        results    = RESULTS_HOST,
        engine     = ENGINE,
        # CPU (Docker)
        db         = DB_HOST,
        data       = DATA_HOST,
        image      = IMAGE,
        # GPU (Jetson Nano SSH)
        ssh_target = SSH_TARGET,
        remote_db  = REMOTE_DB,
        remote_ws  = REMOTE_WS,
        cuclark    = CUCLARK_DIR,
    run:
        os.makedirs(RESULTS_HOST, exist_ok=True)

        if params.engine == "cpu":
            # ── CPU: Docker CLARK-l (local) ────────────────────────────────
            shell(
                'docker run --rm '
                '-v "{params.db}:/db" '
                '-v "{params.data}:/data" '
                '-v "{params.results}:/out" '
                '{params.image} '
                'sh -c "'
                'CLARK-l '
                '-T /db/targets.txt '
                '-D /db/ '
                '-O /data/{params.sample}.fastq '
                '-R /out/{params.sample}.clark '
                '-n {params.threads} '
                '-k {params.kmer} '
                '-m 2'
                '"'
            )

        elif params.engine == "gpu":
            # ── GPU: Jetson Nano via Tailscale SSH ─────────────────────────

            # 0) Connectivity pre-check — fail fast with a clear message
            shell(
                'echo [EDGE] Preparing remote workspace on Jetson Nano... && '
                'ssh -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} -o ConnectTimeout=10 '
                '-o ServerAliveInterval=15 {params.ssh_target} '
                '"mkdir -p {params.remote_ws}" '
                '|| (echo "[EDGE] ERROR: Cannot reach Jetson Nano at {params.ssh_target}. '
                'Check Tailscale VPN and SSH configuration. '
                'If you use password auth, set jetson_nano.ssh_batch_mode: false in config.yaml." && exit 1)'
            )

            # 1) Check if FASTQ already exists on the Nano (skip upload if so)
            import subprocess as _sp
            _remote_fastq = f"{params.remote_ws}/{params.sample}.fastq"
            _need_upload = True
            try:
                print(f"[EDGE] Checking if {_remote_fastq} exists on Jetson Nano...")
                _check = _sp.run(
                    ["ssh", "-o", "StrictHostKeyChecking=no", "-o", f"BatchMode={SSH_BATCH_OPT}",
                     "-o", "ConnectTimeout=10",
                     params.ssh_target, f"test -f {_remote_fastq} && echo EXISTS"],
                    capture_output=True, text=True, timeout=30
                )
                print(f"[EDGE] SSH check: rc={_check.returncode}, stdout={_check.stdout.strip()!r}, stderr={_check.stderr.strip()!r}")
                if _check.returncode == 0:
                    _need_upload = False
            except Exception as _e:
                print(f"[EDGE] SSH check failed with exception: {_e}")

            # 2) Upload FASTQ to Jetson Nano (only if needed)
            if _need_upload:
                shell(
                    'echo [EDGE] Uploading FASTQ to Jetson Nano... && '
                    'scp -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} '
                    '"{input.fastq}" '
                    '{params.ssh_target}:{params.remote_ws}/{params.sample}.fastq'
                )
            else:
                shell('echo [EDGE] FASTQ already present on Jetson Nano — skipping upload')

            # 3) Free GPU memory on the Nano (unified memory — page cache fills RAM)
            shell(
                'echo [EDGE] Freeing GPU memory on Jetson Nano... && '
                'ssh -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} -o ConnectTimeout=10 '
                '-o ServerAliveInterval=15 {params.ssh_target} '
                '"sync && echo 3 | sudo tee /proc/sys/vm/drop_caches > /dev/null"'
            )

            # 4) Run CU-CLARK-L on the Nano (GPU classification)
            #    Launch with nohup in background so it survives SSH disconnects.
            #    First-time runs build .tsk index (30+ min for 903 genomes),
            #    which exceeds SSH keepalive timeouts if run inline.
            _remote_out = f"{params.remote_ws}/{params.sample}.clark.csv"
            _remote_log = f"{params.remote_ws}/cuclark.log"

            # Remove stale output from any previous run so the poll loop
            # doesn't immediately find an old file and declare DONE.
            shell(
                'echo [EDGE] Removing stale results on Jetson Nano... && '
                'ssh -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} -o ConnectTimeout=10 '
                '{params.ssh_target} '
                '"rm -f {params.remote_ws}/{params.sample}.clark '
                '{params.remote_ws}/{params.sample}.clark.csv '
                '{params.remote_ws}/cuclark.log" '
                '|| echo "[EDGE] Warning: stale cleanup failed (non-fatal)"'
            )

            shell(
                'echo [EDGE] Launching CU-CLARK-L on Jetson Nano (background)... && '
                'ssh -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} -o ConnectTimeout=10 '
                '{params.ssh_target} '
                '"nohup {params.cuclark}/exe/cuCLARK-l '
                '-T {params.remote_db}/targets.txt '
                '-D {params.remote_db}/ '
                '-O {params.remote_ws}/{params.sample}.fastq '
                '-R {params.remote_ws}/{params.sample}.clark '
                '-n {params.threads} '
                '-k {params.kmer} '
                '> {params.remote_ws}/cuclark.log 2>&1 </dev/null &"'
            )

            # Poll until classification completes or process exits
            import subprocess as _sp2
            import time as _time

            _MAX_WAIT = 7200   # 2 hours
            _POLL     = 30     # check every 30 seconds
            _elapsed  = 0
            _ssh_base = [
                "ssh", "-o", "StrictHostKeyChecking=no",
                "-o", f"BatchMode={SSH_BATCH_OPT}",
                "-o", "ConnectTimeout=10",
                params.ssh_target,
            ]

            print(f"[EDGE] Polling for completion (max {_MAX_WAIT // 60} min)...")
            while _elapsed < _MAX_WAIT:
                _time.sleep(_POLL)
                _elapsed += _POLL

                try:
                    _check = _sp2.run(
                        _ssh_base + [
                            f"test -f {_remote_out} && echo DONE || "
                            f"(pgrep -f cuCLARK-l > /dev/null 2>&1 && echo RUNNING || echo FAILED)"
                        ],
                        capture_output=True, text=True, timeout=30
                    )
                    _status = _check.stdout.strip().split('\n')[-1]
                except Exception as _poll_err:
                    print(f"[EDGE] Poll SSH error ({_elapsed}s): {_poll_err}")
                    continue   # transient network blip — retry

                if _elapsed % 120 < _POLL:
                    print(f"[EDGE] Status: {_status}  ({_elapsed // 60} min elapsed)")

                if _status == "DONE":
                    print(f"[EDGE] Classification complete after {_elapsed}s")
                    break
                elif _status == "FAILED":
                    # Process exited but no output — read last log lines
                    try:
                        _log = _sp2.run(
                            _ssh_base + [f"tail -20 {_remote_log}"],
                            capture_output=True, text=True, timeout=15
                        )
                        print(f"[EDGE] CU-CLARK-L log tail:\n{_log.stdout}")
                    except Exception:
                        pass
                    raise RuntimeError(
                        "CU-CLARK-L process exited without producing output. "
                        f"Check {_remote_log} on the Jetson Nano."
                    )
            else:
                raise RuntimeError(
                    f"CU-CLARK-L timed out after {_MAX_WAIT // 60} minutes"
                )

            # 4) Download classification CSV back
            shell(
                'echo [EDGE] Downloading classification results from Jetson Nano... && '
                'scp -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} '
                '{params.ssh_target}:{params.remote_ws}/{params.sample}.clark.csv '
                '"{params.results}/{params.sample}.clark.csv"'
            )

            # 5) Cleanup: remove intermediate files from the Nano (non-fatal)
            #    If SSH times out here, classification already succeeded — don't crash.
            #    Note: we intentionally keep the FASTQ for the pre-existence check next run.
            shell(
                'echo [EDGE] Cleaning up remote files on Jetson Nano... && '
                'ssh -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} -o ConnectTimeout=10 '
                '{params.ssh_target} '
                '"rm -f {params.remote_ws}/{params.sample}.clark '
                '{params.remote_ws}/{params.sample}.clark.csv" '
                '|| echo "[EDGE] Warning: cleanup SSH timed out (non-fatal, results already downloaded)"'
            )


# ═══════════════════════════════════════════════════════════════════════════════
# RULE 2 – Abundance estimation
# ═══════════════════════════════════════════════════════════════════════════════
rule clark_abundance_report:
    """
    Estimate species-level abundance from the CLARK classification CSV.
      CPU engine: runs estimate_abundance.sh inside Docker.
      GPU engine: runs locally in Python (downloads taxonomy from Nano once).

    Output CSV columns: Name, TaxID, Lineage, Count, Proportion_All(%), Proportion_Classified(%)
    """
    input:
        clark_csv=f"results/clark/{SAMPLE}.clark.csv"
    output:
        abundance=f"results/clark/{SAMPLE}.abundance.csv"
    params:
        # Shared
        sample     = SAMPLE,
        engine     = ENGINE,
        results    = RESULTS_HOST,
        # CPU (Docker)
        db         = DB_HOST,
        image      = IMAGE,
        clark_dir  = CLARK_DIR,
        # GPU (local Python with taxonomy from Nano)
        ssh_target = SSH_TARGET,
        remote_db  = REMOTE_DB,
        tax_cache  = os.path.join(RESULTS_HOST, ".taxonomy").replace("\\", "/"),
    run:
        if params.engine == "cpu":
            # ── CPU: Docker estimate_abundance.sh ──────────────────────────
            shell(
                'docker run --rm '
                '-v "{params.db}:/db" '
                '-v "{params.results}:/out" '
                '-w {params.clark_dir} '
                '{params.image} '
                'sh -c "'
                './estimate_abundance.sh '
                '-D /db/ '
                '-F /out/{params.sample}.clark.csv '
                '> /out/{params.sample}.abundance.csv'
                '"'
            )

        elif params.engine == "gpu":
            # ── GPU: Local Python abundance estimation ─────────────────────
            from collections import defaultdict

            tax_dir = params.tax_cache
            os.makedirs(tax_dir, exist_ok=True)

            names_path = os.path.join(tax_dir, "names.dmp")
            nodes_path = os.path.join(tax_dir, "nodes.dmp")

            # 1) Download NCBI taxonomy from Nano (cached after first run)
            if not os.path.exists(names_path) or not os.path.exists(nodes_path):
                shell(
                    'echo [EDGE] Downloading taxonomy data from Jetson Nano... && '
                    'scp -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} '
                    '{params.ssh_target}:{params.remote_db}/taxonomy/names.dmp '
                    '"{params.tax_cache}/names.dmp" && '
                    'scp -o StrictHostKeyChecking=no -o BatchMode={SSH_BATCH_OPT} '
                    '{params.ssh_target}:{params.remote_db}/taxonomy/nodes.dmp '
                    '"{params.tax_cache}/nodes.dmp"'
                )

            # 2) Parse NCBI taxonomy
            print("[LOCAL] Parsing NCBI taxonomy...")
            taxid_to_name = {}
            with open(names_path) as f:
                for line in f:
                    parts = line.strip().split("\t|\t")
                    if len(parts) >= 4 and "scientific name" in parts[3]:
                        tid = int(parts[0].strip())
                        taxid_to_name[tid] = parts[1].strip()

            taxid_to_parent = {}
            with open(nodes_path) as f:
                for line in f:
                    parts = line.strip().split("\t|\t")
                    if len(parts) >= 3:
                        tid = int(parts[0].strip())
                        parent = int(parts[1].strip())
                        taxid_to_parent[tid] = parent

            def build_lineage(tid):
                """Build semicolon-separated lineage string from leaf to root."""
                names = []
                current = tid
                seen = set()
                while current and current != 1 and current not in seen:
                    seen.add(current)
                    name = taxid_to_name.get(current, f"taxid_{current}")
                    names.append(name)
                    current = taxid_to_parent.get(current)
                names.reverse()
                return "; ".join(names)

            # 3) Parse CLARK CSV and count reads per taxid
            print("[LOCAL] Computing abundance from classification results...")
            taxid_counts = defaultdict(int)
            total_objects = 0

            with open(input.clark_csv, newline="") as f:
                reader = csv.reader(f)
                # Auto-detect the taxid column from the header.
                # CLARK-l:     Object_ID, Length, 1st_assignment, ...         (index 2)
                # CU-CLARK-L:  Object_ID, Length, Gamma, 1st_assignment, ...  (index 3)
                taxid_col = 2  # default for CLARK-l
                for row in reader:
                    if row and row[0].strip().startswith("Object"):
                        # Find the column index of '1st_assignment'
                        for i, col in enumerate(row):
                            if "1st_assignment" in col.strip():
                                taxid_col = i
                                break
                        print(f"[LOCAL] Detected taxid column at index {taxid_col} "
                              f"({'CU-CLARK-L format' if taxid_col == 3 else 'CLARK-l format'})")
                        break

                for row in reader:
                    if not row:
                        continue
                    total_objects += 1
                    try:
                        taxid = int(row[taxid_col].strip())
                        if taxid > 0:
                            taxid_counts[taxid] += 1
                    except (ValueError, IndexError):
                        pass

            classified = sum(taxid_counts.values())
            unknown = total_objects - classified

            # 4) Write abundance CSV
            with open(output.abundance, "w", newline="") as f:
                writer = csv.writer(f)
                writer.writerow(["Name", "TaxID", "Lineage", "Count",
                                 "Proportion_All(%)", "Proportion_Classified(%)"])

                for tid, cnt in sorted(taxid_counts.items(), key=lambda x: -x[1]):
                    name = taxid_to_name.get(tid, f"Unknown (taxid {tid})")
                    lineage = build_lineage(tid)
                    p_all = round(100.0 * cnt / total_objects, 6) if total_objects > 0 else 0
                    p_cls = round(100.0 * cnt / classified, 6) if classified > 0 else 0
                    writer.writerow([name, tid, lineage, cnt, p_all, p_cls])

                if unknown > 0:
                    p_all = round(100.0 * unknown / total_objects, 6) if total_objects > 0 else 0
                    writer.writerow(["UNKNOWN", "NA", "", unknown, p_all, 0])

            print(f"[LOCAL] Abundance report complete: {len(taxid_counts)} taxa, "
                  f"{classified}/{total_objects} classified")


# ═══════════════════════════════════════════════════════════════════════════════
# RULE 3 – JSON conversion (LOCAL – same for both engines)
# ═══════════════════════════════════════════════════════════════════════════════
rule clark_to_json:
    """
    Convert CLARK abundance CSV to JSON matching the Pathogenius Electron UI
    (same shape as frontend mock results.json), plus legacy fields for scripts.

    This rule runs LOCALLY for both engines. It reads the abundance CSV and
    produces the final JSON for the UI.

    Input CSV columns (estimate_abundance.sh or local Python):
      Name, TaxID, Lineage, Count, Proportion_All(%), Proportion_Classified(%)
    """
    input:
        abundance="results/clark/{sample}.abundance.csv"
    output:
        json="results/clark/{sample}.json"
    params:
        engine = ENGINE,
    run:
        # Taxa commonly flagged as higher clinical interest for this panel (heuristic UI risk)
        high_priority_taxa = {
            470, 550, 562, 666, 727, 287, 1280, 1313, 1773, 1513, 5501, 5833, 210, 480,
        }

        rows_data = []
        unknown_reads = 0
        total_reads = 0

        with open(input.abundance, newline="") as f:
            reader = csv.reader(f)
            for row in reader:
                if not row or row[0].startswith("#"):
                    continue
                if row[0].strip() == "Name":
                    header_skipped = True
                    continue
                if len(row) < 5:
                    continue

                name = row[0].strip()
                lineage = row[2].strip() if len(row) > 2 else ""
                try:
                    reads = int(row[3].strip())
                except (ValueError, IndexError):
                    reads = 0

                prop_all = 0.0
                prop_classified = 0.0
                try:
                    prop_all = float(row[4].strip())
                except (ValueError, IndexError):
                    pass
                if len(row) > 5:
                    try:
                        prop_classified = float(row[5].strip())
                    except (ValueError, IndexError):
                        prop_classified = 0.0

                total_reads += reads

                if name == "UNKNOWN":
                    unknown_reads += reads
                    continue

                taxid = None
                try:
                    taxid = int(row[1].strip())
                except (ValueError, IndexError):
                    pass

                rows_data.append({
                    "name": name,
                    "tax_id": taxid,
                    "lineage": lineage,
                    "reads": reads,
                    "proportion_all": prop_all,
                    "proportion_classified": prop_classified,
                })

        classified_reads = total_reads - unknown_reads
        if total_reads <= 0:
            classification_rate = 0.0
        else:
            classification_rate = round(100.0 * classified_reads / total_reads, 2)

        species_detected = len(rows_data)

        pathogens_min = []
        pathogens_ui = []

        def strain_from_lineage(lin):
            if not lin:
                return "—"
            parts = [p.strip() for p in lin.split(";") if p.strip()]
            return parts[-1] if parts else "—"

        def risk_level(name, tax_id, abundance):
            if tax_id is not None and tax_id in high_priority_taxa:
                return "high"
            if abundance >= 1.0:
                return "medium"
            return "low"

        def confidence_score(abundance, reads):
            base = 60.0 + min(35.0, float(abundance) * 8.0 + min(reads, 5000) / 500.0)
            return int(max(55, min(99, round(base))))

        proto_pc = 0.0
        firm_pc = 0.0
        virus_pc = 0.0

        for r in rows_data:
            p_all = r["proportion_all"]
            pc = r["proportion_classified"] if r["proportion_classified"] > 0 else p_all
            lin_l = (r["lineage"] or "").lower()
            if "viruses" in lin_l:
                virus_pc += pc
            if "proteobacteria" in lin_l or "pseudomonadota" in lin_l:
                proto_pc += pc
            if "firmicutes" in lin_l or "bacillota" in lin_l:
                firm_pc += pc

            if p_all > 0.01 and r["tax_id"] is not None:
                tid = r["tax_id"]
                pathogens_min.append({
                    "name": r["name"],
                    "tax_id": tid,
                    "abundance": round(p_all, 6),
                    "reads": r["reads"],
                })
                pathogens_ui.append({
                    "name": r["name"],
                    "strain": strain_from_lineage(r["lineage"]),
                    "tax_id": tid,
                    "abundance": round(p_all, 2),
                    "reads": r["reads"],
                    "confidence": confidence_score(p_all, r["reads"]),
                    "amr_genes": 0,
                    "virulence_genes": 0,
                    "risk_level": risk_level(r["name"], tid, p_all),
                })

        pathogens_ui.sort(key=lambda x: x["abundance"], reverse=True)

        now = datetime.now()
        completed_iso = now.strftime("%Y-%m-%dT%H:%M:%S.000Z")
        classifier_name = "CU-CLARK-L (GPU)" if params.engine == "gpu" else "CLARK-l"

        output_data = {
            "analysis_name": wildcards.sample,
            "sample_type": "clinical",
            "completed_at": completed_iso,
            "sample_id": wildcards.sample,
            "processed_date": now.strftime("%Y-%m-%d %H:%M:%S"),
            "classifier": classifier_name,
            "summary": {
                "total_reads": total_reads,
                "classified_reads": classified_reads,
                "classification_rate": classification_rate,
                "species_detected": species_detected,
                "pathogens_detected": len(pathogens_ui),
                "amr_genes": 0,
            },
            "quality": {
                "average_quality": None,
                "high_quality_rate": None,
                "mean_coverage": None,
                "note": f"Not computed by {classifier_name} pipeline",
            },
            "pathogens": pathogens_ui,
            "pathogens_detected": pathogens_min,
            "taxonomy": {
                "bacteria": classification_rate,
                "viruses": round(virus_pc, 2),
                "proteobacteria": round(min(100.0, proto_pc), 2),
                "firmicutes": round(min(100.0, firm_pc), 2),
            },
        }

        with open(output.json, "w") as out:
            json.dump(output_data, out, indent=2)
